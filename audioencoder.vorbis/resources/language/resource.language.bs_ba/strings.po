msgctxt "Addon Summary"
msgid "Vorbis audio compression"
msgstr "Vorbis audio kompresija"

msgctxt "Addon Description"
msgid "Vorbis is a general purpose perceptual audio CODEC intended to allow maximum encoder flexibility, thus allowing it to scale competitively over an exceptionally wide range of bitrates."
msgstr "Vorbis je perceptivni audio kodek opće namjene namijenjen maksimalnoj fleksibilnosti kodera, što mu omogućava konkurentno skaliranje u izuzetno širokom rasponu brzina prijenosa podataka."

msgctxt "#30000"
msgid "Preset"
msgstr "Podes"

msgctxt "#30001"
msgid "Enables some preconfigured settings"
msgstr "Omogućava neke unaprijed konfigurirane postavke"

msgctxt "#30002"
msgid "Medium"
msgstr "Umjereno"

msgctxt "#30003"
msgid "Standard"
msgstr "Standardno"

msgctxt "#30004"
msgid "Extreme"
msgstr "Ekstremno"

msgctxt "#30005"
msgid "Constant bitrate"
msgstr "Konstantna brzina prijenosa podataka"

msgctxt "#30006"
msgid "Bitrate"
msgstr "Brzina prijenosa podataka"

msgctxt "#30007"
msgid "The bitrate to be used"
msgstr "Brzina prijenosa podataka koja će se koristiti"

msgctxt "#30008"
msgid "{0:d} kHz"
msgstr "{0:d} kHz"
