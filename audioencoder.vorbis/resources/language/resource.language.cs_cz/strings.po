msgid "Medium"
msgstr "Střední"

msgctxt "#30003"
msgid "Standard"
msgstr "Standardní"

msgctxt "#30004"
msgid "Extreme"
msgstr "Extrémní"

msgctxt "#30005"
msgid "Constant bitrate"
msgstr "Konstantní datový tok"

msgctxt "#30006"
msgid "Bitrate"
msgstr "Datový tok"

msgctxt "#30007"
